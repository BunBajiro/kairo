+  assert.equal(removals, 0);
+  assert.equal(JSON.parse(await readFile(join(dataDir, 'datasets', 'active.json'))).directory, basename(active.directory));
+  assert.equal(JSON.parse(await readFile(join(dataDir, 'datasets', 'pending.json'))).directory, basename(candidate.directory));

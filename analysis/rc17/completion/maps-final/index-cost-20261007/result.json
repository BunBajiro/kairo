  "sources": [
    {
      "sourceCommit": "fa6e852b76089b51cd552fa202de85ad6948b0ec",
      "sourceFingerprint": "39b0f3e5bb815d4455dada3db3f891b90393159c2674d1ac572aebb199cc34a6",
      "sourceSha256": "caa2e590f265f910c883f3e8ebea829bf1d321465b4fa6c6799bdec3bd5ec561",
      "schema": "CREATE TABLE IF NOT EXISTS universe_records(\n        character_id INTEGER NOT NULL,kind TEXT NOT NULL,id TEXT NOT NULL,body TEXT NOT NULL,updated_at TEXT NOT NULL,\n        PRIMARY KEY(character_id,kind,id));\n        CREATE INDEX IF NOT EXISTS idx_universe_records_character_kind ON universe_records(character_id,kind,updated_at DESC);\n        CREATE INDEX IF NOT EXISTS idx_universe_links_scope ON universe_records(character_id,COALESCE(json_extract(body,'$.map_id'),''),updated_at DESC,id) WHERE kind='link';",
      "queries": {
        "nextWormholeExpiry": "SELECT json_extract(body,'$.expires_at') expires_at FROM universe_records WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND julianday(json_extract(body,'$.expires_at')) IS NOT NULL ORDER BY julianday(json_extract(body,'$.expires_at')) LIMIT 1",
        "expiredWormholes": "SELECT character_id,body FROM universe_records WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND (json_extract(body,'$.life_status')='collapsed' OR julianday(json_extract(body,'$.expires_at'))<=julianday(?))",
        "expiredPilotWormholes": "SELECT character_id,body FROM universe_records WHERE character_id=? AND kind='link' AND json_extract(body,'$.kind')='wormhole' AND (json_extract(body,'$.life_status')='collapsed' OR julianday(json_extract(body,'$.expires_at'))<=julianday(?))"
      },
      "write": "INSERT INTO universe_records VALUES(?,?,?,?,?) ON CONFLICT(character_id,kind,id) DO UPDATE SET body=excluded.body,updated_at=excluded.updated_at"
    },
    {
      "sourceCommit": "c954c0d808847f249df0659ed15fdce2e89f84c4",
      "sourceFingerprint": "472afe35fc135243350cad554205ac5845e5bd9404e81838a52aca8d09b63b27",
      "sourceSha256": "81732780f6d7af9e0b8e61b1b1fbdf6c28d59312239cdf0c475a7a6fe8f1d732",
      "schema": "CREATE TABLE IF NOT EXISTS universe_records(\n        character_id INTEGER NOT NULL,kind TEXT NOT NULL,id TEXT NOT NULL,body TEXT NOT NULL,updated_at TEXT NOT NULL,\n        PRIMARY KEY(character_id,kind,id));\n        CREATE INDEX IF NOT EXISTS idx_universe_records_character_kind ON universe_records(character_id,kind,updated_at DESC);\n        CREATE INDEX IF NOT EXISTS idx_universe_links_scope ON universe_records(character_id,COALESCE(json_extract(body,'$.map_id'),''),updated_at DESC,id) WHERE kind='link';\n        CREATE INDEX IF NOT EXISTS idx_universe_wormholes_expiry ON universe_records(julianday(json_extract(body,'$.expires_at')),character_id) WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND julianday(json_extract(body,'$.expires_at')) IS NOT NULL;\n        CREATE INDEX IF NOT EXISTS idx_universe_wormholes_pilot_expiry ON universe_records(character_id,julianday(json_extract(body,'$.expires_at'))) WHERE kind='link' AND json_extract(body,'$.kind')='wormhole';\n        CREATE INDEX IF NOT EXISTS idx_universe_wormholes_collapsed ON universe_records(character_id) WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND json_extract(body,'$.life_status')='collapsed';",
      "queries": {
        "nextWormholeExpiry": "SELECT json_extract(body,'$.expires_at') expires_at FROM universe_records WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND julianday(json_extract(body,'$.expires_at')) IS NOT NULL ORDER BY julianday(json_extract(body,'$.expires_at')) LIMIT 1",
        "expiredWormholes": "SELECT character_id,body FROM universe_records INDEXED BY idx_universe_wormholes_collapsed WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND json_extract(body,'$.life_status')='collapsed' UNION ALL SELECT character_id,body FROM universe_records WHERE kind='link' AND json_extract(body,'$.kind')='wormhole' AND julianday(json_extract(body,'$.expires_at'))<=julianday(?) AND json_extract(body,'$.life_status') IS NOT 'collapsed'",
        "expiredPilotWormholes": "SELECT character_id,body FROM universe_records INDEXED BY idx_universe_wormholes_collapsed WHERE character_id=? AND kind='link' AND json_extract(body,'$.kind')='wormhole' AND json_extract(body,'$.life_status')='collapsed' UNION ALL SELECT character_id,body FROM universe_records WHERE character_id=? AND kind='link' AND json_extract(body,'$.kind')='wormhole' AND julianday(json_extract(body,'$.expires_at'))<=julianday(?) AND json_extract(body,'$.life_status') IS NOT 'collapsed'"
      },
      "write": "INSERT INTO universe_records VALUES(?,?,?,?,?) ON CONFLICT(character_id,kind,id) DO UPDATE SET body=excluded.body,updated_at=excluded.updated_at"
    }
  ],

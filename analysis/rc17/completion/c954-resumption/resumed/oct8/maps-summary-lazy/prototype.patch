+test('owner/key/kind moves and replace collisions invalidate both identities', t => {
+    const f = fixture(t), a = map('map-a'), b = map('map-b'); f.put(a); f.put(b, 43); warm(f); warm(f, 43);
+    f.db.prepare("UPDATE OR REPLACE universe_records SET character_id=43,id=? WHERE character_id=42 AND kind='jspace_map' AND id=?").run(b.id, a.id);
+    assert.equal(f.side(a.id), undefined); const moved = f.inputs.all(43)[0];
+    assert.equal(moved.record_id, b.id); assert.equal(JSON.parse(moved.body).id, a.id); assert.equal(moved.compact, 0);
+    f.put({ ...b, name: 'Other kind' }, 43, 'view');
+    f.db.prepare("UPDATE OR REPLACE universe_records SET kind='view' WHERE character_id=43 AND kind='jspace_map'").run();
+    assert.equal(f.side(b.id, 43), undefined);
+    f.put(b, 43);
+    f.db.prepare("UPDATE OR REPLACE universe_records SET kind='jspace_map' WHERE character_id=43 AND kind='view'").run();
+    assert.equal(parsed(f.inputs, 43)[0].id, a.id);
+    f.db.prepare('INSERT OR REPLACE INTO universe_records VALUES(?,?,?,?,?)').run(43, 'jspace_map', b.id, JSON.stringify(b), AT);
+    assert.equal(parsed(f.inputs, 43)[0].id, b.id); assert.equal(f.side(b.id, 43).state, 0);
+});

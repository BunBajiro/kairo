+import { createJSpaceSummaryInputs, compactJSpaceSummaryInput } from '../../server/universe-jspace-summary-inputs.mjs';
+
+const TABLE = 'universe_jspace_summary_inputs_v1';
+const AT = '2026-10-08T12:00:00.000Z';
+function map(id = 'map-a', name = id) {
+    return { id, name, description: 'Map description', revision: 1, created_at: AT, updated_at: AT,
+        nodes: [{ system_id: 31000001, locked: true, description: 'Keep full node' }, { system_id: 31000002, locked: false }],
+        connections: [{ id: 'edge-a', link_id: 'link-a', kind: 'wormhole', from_system_id: 31000001, to_system_id: 31000002 }],
+        comments: [{ connection_id: 'edge-a', body: 'Keep full comment' }],
+        passages: [{ connection_id: 'edge-a', notes: 'Keep full passage' }],
+        observations: [{ body: 'Keep full observation' }], archived_nodes: [], pings: [], activity: [], pilots: [{ character_id: 42 }] };
+}
+function fixture(t, install = true) {
+    const dir = mkdtempSync(join(tmpdir(), 'kairo-jspace-summary-inputs-')), path = join(dir, 'test.sqlite'), handles = [];
+    const open = () => { const db = new DatabaseSync(path); db.exec('PRAGMA busy_timeout=0'); handles.push(db); return db; };
+    const db = open();
+    db.exec(`PRAGMA journal_mode=WAL;
+        CREATE TABLE universe_records(character_id INTEGER NOT NULL,kind TEXT NOT NULL,id TEXT NOT NULL,
+            body TEXT NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(character_id,kind,id));`);
+    t.after(() => { for (const handle of handles) try { handle.close(); } catch {} rmSync(dir, { recursive: true, force: true }); });
+    const put = (value, owner = 42, kind = 'jspace_map') => db.prepare(`INSERT INTO universe_records VALUES(?,?,?,?,?)
+        ON CONFLICT(character_id,kind,id) DO UPDATE SET body=excluded.body,updated_at=excluded.updated_at`)
+        .run(owner, kind, value.id, JSON.stringify(value), value.updated_at || AT);
+    const raw = (id, owner = 42) => db.prepare("SELECT body FROM universe_records WHERE character_id=? AND kind='jspace_map' AND id=?").get(owner, id)?.body;
+    const side = (id, owner = 42) => db.prepare(`SELECT body,state,format_version,CAST(generation AS TEXT) AS token FROM ${TABLE} WHERE character_id=? AND id=?`).get(owner, id);
+    return { db, open, put, raw, side, inputs: install ? createJSpaceSummaryInputs(db) : null };
+}
+const parsed = (inputs, owner = 42) => inputs.all(owner).map(row => JSON.parse(row.body));
+
+function warm(f, owner = 42) {
+    for (const row of f.inputs.all(owner)) if (row.needs_fill)
+        f.inputs.fill(owner, row.record_id, row.generation, compactJSpaceSummaryInput(JSON.parse(row.body)));
+    return f.inputs.all(owner);
+}
+const changes = db => db.prepare('SELECT total_changes() AS n').get().n;
+
+test('installation does not backfill; first read derives once and steady/reopen reads do not write', t => {
+    const f = fixture(t, false), value = map(); f.put(value); const original = f.raw(value.id);
+    f.inputs = createJSpaceSummaryInputs(f.db);
+    assert.equal(f.db.prepare(`SELECT count(*) AS n FROM ${TABLE}`).get().n, 0);
+    assert.equal(f.raw(value.id), original);
+    const first = f.inputs.all(42)[0]; assert.equal(first.body, original); assert.equal(first.compact, 0);
+    assert.equal(f.inputs.fill(42, first.record_id, first.generation, compactJSpaceSummaryInput(JSON.parse(first.body))), 1);
+    const next = f.inputs.all(42)[0]; assert.equal(next.compact, 1); assert.equal(next.needs_fill, 0);
+    assert.ok(!next.body.includes('Keep full')); assert.equal(f.raw(value.id), original);
+    const before = changes(f.db); assert.deepEqual(f.inputs.all(42), [next]);
+    createJSpaceSummaryInputs(f.db); assert.equal(changes(f.db), before);
+    f.db.close(); const reopened = f.open(), inputs = createJSpaceSummaryInputs(reopened);
+    assert.deepEqual(inputs.all(42), [next]); assert.equal(changes(reopened), 0);
+});
+
+test('builder drops arbitrary connection payload and preserves required absence/null/boolean behavior', () => {
+    const value = map(); value.connections[0].notes = 'Large '.repeat(1000);
+    value.connections[0].custom = { nested: ['Large '.repeat(1000)] };
+    const input = compactJSpaceSummaryInput(value);
+    assert.deepEqual(input.connections, [{ id: 'edge-a', kind: 'wormhole', link_id: 'link-a', from_system_id: 31000001, to_system_id: 31000002 }]);
+    assert.equal(input.nodes[0].locked, true); assert.equal(input.nodes[1].locked, false);
+    assert.ok(!Object.hasOwn(input.nodes[0], 'disconnected_at'));
+    delete value.connections[0].link_id;
+    assert.ok(!Object.hasOwn(compactJSpaceSummaryInput(value).connections[0], 'link_id'));
+    value.connections[0].link_id = null;
+    assert.equal(compactJSpaceSummaryInput(value).connections[0].link_id, null);
+    for (const locked of [false, true, null, 0, '']) {
+        value.connections[0].locked = locked;
+        assert.equal(compactJSpaceSummaryInput(value), null, 'Any own locked value requires full cleanup');
+    }
+});

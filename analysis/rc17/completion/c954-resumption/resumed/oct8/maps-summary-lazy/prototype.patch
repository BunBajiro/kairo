+test('unsupported legacy input receives one fallback marker; malformed JSON remains unparsed source', t => {
+    const f = fixture(t), value = map(); value.passages = ['{"connection_id":"edge-a"}']; f.put(value);
+    warm(f); assert.equal(f.side(value.id).state, 2); const before = changes(f.db);
+    assert.equal(f.inputs.all(42)[0].body, f.raw(value.id)); assert.equal(f.inputs.all(42)[0].needs_fill, 0);
+    warm(f); assert.equal(changes(f.db), before);
+    f.db.prepare("UPDATE universe_records SET body='not JSON' WHERE kind='jspace_map'").run();
+    const row = f.inputs.all(42)[0]; assert.equal(row.body, 'not JSON');
+    assert.throws(() => compactJSpaceSummaryInput(JSON.parse(row.body))); assert.equal(f.side(value.id).state, 0);
+});
+
+test('duplicate JSON keys use the already-decoded JavaScript value without rewriting authority', t => {
+    const f = fixture(t), value = map(); const body = JSON.stringify(value).replace('"name":"map-a"', '"name":"Earlier","name":"Later"');
+    f.db.prepare('INSERT INTO universe_records VALUES(?,?,?,?,?)').run(42, 'jspace_map', value.id, body, AT);
+    warm(f); assert.equal(parsed(f.inputs)[0].name, 'Later'); assert.equal(f.raw(value.id), body);
+});
+
+test('same revision replacement invalidates immediately and parent ordering remains authoritative', t => {
+    const f = fixture(t), a = map('map-a'), b = map('map-b'); f.put(a); f.put(b); warm(f);
+    const old = f.side(a.id).token; f.put({ ...a, name: 'Changed at same revision' });
+    assert.notEqual(f.side(a.id).token, old); assert.equal(f.side(a.id).state, 0);
+    assert.equal(parsed(f.inputs)[0].name, 'Changed at same revision'); warm(f);
+    const token = f.side(b.id).token;
+    f.db.prepare("UPDATE universe_records SET updated_at=? WHERE character_id=42 AND kind='jspace_map' AND id=?").run('2026-10-09T00:00:00Z', b.id);
+    assert.deepEqual(parsed(f.inputs).map(row => row.id), [b.id, a.id]); assert.equal(f.side(b.id).token, token);
+});

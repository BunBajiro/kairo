--- /dev/null
+++ b/server/universe-jspace-summary-inputs.mjs
@@ -0,0 +1,111 @@
+// Optional private derivatives. Authoritative maps, links and time stay outside
+// this table; triggers invalidate every direct or service map-body replacement.
+const TABLE = 'universe_jspace_summary_inputs_v1';
+const INSERT = TABLE + '_insert', UPDATE = TABLE + '_update', DELETE = TABLE + '_delete';
+const FORMAT = 1;
+const own = (value, key) => Object.prototype.hasOwnProperty.call(value, key);
+const object = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const optional = (value, key, check) => !own(value, key) || value[key] === null || check(value[key]);
+const text = value => typeof value === 'string';
+const contention = error => Number.isInteger(error.errcode) && [5, 6].includes(error.errcode & 255);
+function pick(value, keys) {
+    const result = {};
+    for (const key of keys) if (own(value, key)) result[key] = value[key];
+    return result;
+}
+
+// Input was already parsed by JavaScript. Unsupported legacy shapes use the
+// existing full path, including its errors; no SQL JSON interpretation occurs.
+export function compactJSpaceSummaryInput(map) {
+    if (!object(map) || own(map, 'archived_connections') ||
+        !['nodes', 'connections', 'comments', 'passages', 'activity'].every(key => Array.isArray(map[key])) ||
+        !optional(map, 'pilots', Array.isArray)) return null;
+    if (!map.nodes.every(row => object(row) && Number.isSafeInteger(row.system_id) &&
+        optional(row, 'locked', value => typeof value === 'boolean') &&
+        optional(row, 'disconnected_at', text) && optional(row, 'prune_grace_at', text))) return null;
+    if (!map.connections.every(row => object(row) && text(row.id) && text(row.kind) &&
+        Number.isSafeInteger(row.from_system_id) && Number.isSafeInteger(row.to_system_id) &&
+        optional(row, 'link_id', text) && !own(row, 'locked'))) return null;
+    if (!map.comments.every(row => object(row) && optional(row, 'connection_id', text)) ||
+        !map.passages.every(row => object(row) && text(row.connection_id)) ||
+        !map.activity.every(row => object(row) && optional(row, 'op', text))) return null;
+    return {
+        ...pick(map, ['id', 'name', 'description', 'kind', 'revision', 'created_at', 'updated_at', 'scope']),
+        nodes: map.nodes.map(row => pick(row, ['system_id', 'locked', 'disconnected_at', 'prune_grace_at'])),
+        connections: map.connections.map(row => pick(row, ['id', 'kind', 'link_id', 'from_system_id', 'to_system_id'])),
+        comments: map.comments.map(row => pick(row, ['connection_id'])),
+        passages: map.passages.map(row => pick(row, ['connection_id'])),
+        activity: map.activity.map(row => pick(row, ['op'])),
+        pilots: (map.pilots || []).map(() => null),
+    };
+}
+
+export function createJSpaceSummaryInputs(db) {
+    const installed = db.prepare(`SELECT count(*) AS n FROM sqlite_schema WHERE
+        (type='table' AND name=?) OR (type='trigger' AND name IN (?,?,?))`).get(TABLE, INSERT, UPDATE, DELETE).n === 4;
+    db.exec('SAVEPOINT kairo_jspace_summary_inputs_install');
+    try {
+        db.exec(`CREATE TABLE IF NOT EXISTS ${TABLE}(
+            generation INTEGER PRIMARY KEY AUTOINCREMENT,
+            character_id INTEGER NOT NULL,id TEXT NOT NULL,
+            state INTEGER NOT NULL DEFAULT 0 CHECK(state IN (0,1,2)),
+            format_version INTEGER,body TEXT,UNIQUE(character_id,id));
+        CREATE TRIGGER IF NOT EXISTS ${INSERT} AFTER INSERT ON universe_records WHEN NEW.kind='jspace_map' BEGIN
+            DELETE FROM ${TABLE} WHERE character_id=NEW.character_id AND id=NEW.id;
+            INSERT INTO ${TABLE}(character_id,id) VALUES(NEW.character_id,NEW.id);
+        END;
+        CREATE TRIGGER IF NOT EXISTS ${UPDATE} AFTER UPDATE OF character_id,kind,id,body ON universe_records
+        WHEN OLD.kind='jspace_map' OR NEW.kind='jspace_map' BEGIN
+            DELETE FROM ${TABLE} WHERE (OLD.kind='jspace_map' AND character_id=OLD.character_id AND id=OLD.id)
+                OR (NEW.kind='jspace_map' AND character_id=NEW.character_id AND id=NEW.id);
+            INSERT INTO ${TABLE}(character_id,id) SELECT NEW.character_id,NEW.id WHERE NEW.kind='jspace_map';
+        END;
+        CREATE TRIGGER IF NOT EXISTS ${DELETE} AFTER DELETE ON universe_records WHEN OLD.kind='jspace_map' BEGIN
+            DELETE FROM ${TABLE} WHERE character_id=OLD.character_id AND id=OLD.id;
+        END;`);
+        // A missing trigger may have allowed unseen writes. Drop derivatives,
+        // keeping the generation sequence; do not scan/backfill parent bodies.
+        if (!installed) db.exec(`DELETE FROM ${TABLE}`);
+        db.exec('RELEASE kairo_jspace_summary_inputs_install');
+    } catch (error) {
+        db.exec('ROLLBACK TO kairo_jspace_summary_inputs_install');
+        db.exec('RELEASE kairo_jspace_summary_inputs_install');
+        throw error;
+    }
+    const missing = db.prepare(`SELECT 1 FROM universe_records AS records LEFT JOIN ${TABLE} AS inputs
+        ON inputs.character_id=records.character_id AND inputs.id=records.id
+        WHERE records.character_id=? AND records.kind='jspace_map' AND inputs.generation IS NULL LIMIT 1`);
+    const seed = db.prepare(`INSERT INTO ${TABLE}(character_id,id)
+        SELECT records.character_id,records.id FROM universe_records AS records
+        WHERE records.character_id=? AND records.kind='jspace_map' AND NOT EXISTS
+            (SELECT 1 FROM ${TABLE} AS inputs WHERE inputs.character_id=records.character_id AND inputs.id=records.id)`);
+    const rows = db.prepare(`SELECT records.id AS record_id,CAST(inputs.generation AS TEXT) AS generation,
+        inputs.state=1 AND inputs.format_version=${FORMAT} AS compact,
+        inputs.generation IS NOT NULL AND (inputs.state=0 OR inputs.format_version IS NOT ${FORMAT}) AS needs_fill,
+        CASE WHEN inputs.state=1 AND inputs.format_version=${FORMAT} THEN inputs.body ELSE records.body END AS body
+        FROM universe_records AS records LEFT JOIN ${TABLE} AS inputs
+        ON inputs.character_id=records.character_id AND inputs.id=records.id
+        WHERE records.character_id=? AND records.kind='jspace_map'
+        ORDER BY records.updated_at DESC,records.id`);
+    const ready = db.prepare(`SELECT 1 FROM ${TABLE} WHERE character_id=? AND id=? AND state=1 AND format_version=?`);
+    const fill = db.prepare(`UPDATE ${TABLE} SET state=?,format_version=?,body=?
+        WHERE character_id=? AND id=? AND generation=? AND (state=0 OR format_version IS NOT ?)`);
+    return {
+        all(id) {
+            if (missing.get(id)) try { seed.run(id); } catch (error) { if (!contention(error)) throw error; }
+            return rows.all(id);
+        },
+        hasReady: (id, key) => !!ready.get(id, key, FORMAT),
+        fill(id, key, generation, compact) {
+            // One conditional statement: a changed/deleted generation cannot
+            // receive this snapshot. Only lock contention is a harmless miss;
+            // do not hide authoritative parse/cleanup or database failures.
+            try { return fill.run(compact ? 1 : 2, FORMAT, compact ? JSON.stringify(compact) : null,
+                id, key, generation, FORMAT).changes; }
+            catch (error) {
+                if (contention(error)) return 0;
+                throw error;
+            }
+        },
+    };
+}

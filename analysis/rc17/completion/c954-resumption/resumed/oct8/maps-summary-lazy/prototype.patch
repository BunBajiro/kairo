+test('stale fill is rejected across a second-handle update and delete/reinsert at the same key', t => {
+    const f = fixture(t), value = map(); f.put(value);
+    const first = f.inputs.all(42)[0], writer = f.open();
+    writer.prepare("UPDATE universe_records SET body=? WHERE kind='jspace_map'").run(JSON.stringify({ ...value, name: 'Other writer' }));
+    assert.equal(f.inputs.fill(42, first.record_id, first.generation, compactJSpaceSummaryInput(JSON.parse(first.body))), 0);
+    const second = f.inputs.all(42)[0]; assert.equal(JSON.parse(second.body).name, 'Other writer');
+    writer.prepare("DELETE FROM universe_records WHERE kind='jspace_map'").run();
+    writer.prepare('INSERT INTO universe_records VALUES(?,?,?,?,?)').run(42, 'jspace_map', value.id, JSON.stringify(value), AT);
+    assert.notEqual(f.inputs.all(42)[0].generation, second.generation);
+    assert.equal(f.inputs.fill(42, second.record_id, second.generation, compactJSpaceSummaryInput(JSON.parse(second.body))), 0);
+    assert.equal(f.side(value.id).state, 0);
+});

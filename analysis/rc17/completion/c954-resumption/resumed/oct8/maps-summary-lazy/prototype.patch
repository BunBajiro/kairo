+test('parent transaction and nested savepoint roll back authoritative and derivative changes together', t => {
+    const f = fixture(t), value = map(); f.put(value); warm(f);
+    const original = f.side(value.id), body = f.raw(value.id);
+    f.db.exec('BEGIN IMMEDIATE'); f.put({ ...value, name: 'Outer' }); warm(f); const outer = f.side(value.id);
+    f.db.exec('SAVEPOINT caller'); f.put({ ...value, name: 'Inner' }); warm(f);
+    f.db.exec('ROLLBACK TO caller; RELEASE caller'); assert.deepEqual(f.side(value.id), outer);
+    f.db.exec('ROLLBACK'); assert.deepEqual(f.side(value.id), original); assert.equal(f.raw(value.id), body);
+    f.db.prepare('INSERT OR IGNORE INTO universe_records VALUES(?,?,?,?,?)').run(42, 'jspace_map', value.id, JSON.stringify(value), AT);
+    assert.deepEqual(f.side(value.id), original);
+});

+test('generations beyond 2^53 stay exact through invalidation and guarded publication', t => {
+    const f = fixture(t), value = map(); f.put(value);
+    f.db.prepare('UPDATE sqlite_sequence SET seq=? WHERE name=?').run('9007199254740992', TABLE);
+    f.put({ ...value, name: 'Large generation' });
+    const first = f.inputs.all(42)[0]; assert.equal(first.generation, '9007199254740993');
+    f.put(value); const second = f.inputs.all(42)[0]; assert.equal(second.generation, '9007199254740994');
+    assert.equal(f.inputs.fill(42, first.record_id, first.generation, compactJSpaceSummaryInput(JSON.parse(first.body))), 0);

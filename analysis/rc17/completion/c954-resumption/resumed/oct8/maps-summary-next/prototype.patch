index 0000000..0951b7c
--- /dev/null
+++ b/server/universe-jspace-summary-inputs.mjs
@@ -0,0 +1,79 @@
+// Private, rebuildable derivatives of complete jspace_map documents. Only the
+// original document is authoritative. No canonical links or time are cached.
+const TABLE = 'universe_jspace_summary_inputs_v1';
+const INSERT = TABLE + '_insert', UPDATE = TABLE + '_update', DELETE = TABLE + '_delete';
+
+function compactBody(source) {
+    // Unsupported legacy values retain the existing full-document path. In
+    // particular, SQL path lookup must not reinterpret primitive array values
+    // or choose a different duplicate object key from JavaScript JSON.parse.
+    return `CASE WHEN json_valid(${source}) THEN (
+        SELECT CASE WHEN json_type(doc,'$.nodes')='array' AND json_type(doc,'$.connections')='array'
+            AND json_type(doc,'$.comments')='array' AND json_type(doc,'$.passages')='array'
+            AND NOT EXISTS (SELECT 1 FROM json_tree(doc) WHERE typeof(key)='text' GROUP BY parent,key HAVING count(*)>1)
+            AND NOT EXISTS (SELECT 1 FROM json_each(doc,'$.nodes') WHERE CASE WHEN type<>'object' THEN 1 ELSE
+                json_type(value,'$.system_id') IS NOT 'integer'
+                OR COALESCE(json_type(value,'$.locked'),'null') NOT IN ('null','true','false')
+                OR COALESCE(json_type(value,'$.disconnected_at'),'null') NOT IN ('null','text')
+                OR COALESCE(json_type(value,'$.prune_grace_at'),'null') NOT IN ('null','text') END)
+            AND NOT EXISTS (SELECT 1 FROM json_each(doc,'$.connections') WHERE CASE WHEN type<>'object' THEN 1 ELSE
+                json_type(value,'$.id') IS NOT 'text' OR json_type(value,'$.kind') IS NOT 'text'
+                OR json_type(value,'$.from_system_id') IS NOT 'integer' OR json_type(value,'$.to_system_id') IS NOT 'integer' END)
+            AND NOT EXISTS (SELECT 1 FROM json_each(doc,'$.comments') WHERE CASE WHEN type<>'object' THEN 1 ELSE
+                COALESCE(json_type(value,'$.connection_id'),'null') NOT IN ('null','text') END)
+            AND NOT EXISTS (SELECT 1 FROM json_each(doc,'$.passages') WHERE CASE WHEN type<>'object' THEN 1 ELSE
+                json_type(value,'$.connection_id') IS NOT 'text' END) THEN
+            json_set(jsonb_remove(doc,'$.nodes','$.comments','$.passages','$.archived_nodes','$.observations','$.pings'),
+                '$.nodes', (SELECT json_group_array(json_object('system_id',value -> '$.system_id',
+                    'locked',value -> '$.locked','disconnected_at',value -> '$.disconnected_at',
+                    'prune_grace_at',value -> '$.prune_grace_at')) FROM json_each(doc,'$.nodes')),
+                '$.comments', (SELECT json_group_array(json_object('connection_id',value -> '$.connection_id')) FROM json_each(doc,'$.comments')),
+                '$.passages', (SELECT json_group_array(json_object('connection_id',value -> '$.connection_id')) FROM json_each(doc,'$.passages')))
+            ELSE NULL END
+        FROM (SELECT jsonb(${source}) AS doc LIMIT -1)
+    ) ELSE NULL END`;
+}
+
+export function createJSpaceSummaryInputs(db) {
+    const installed = db.prepare(`SELECT count(*) AS n FROM sqlite_schema WHERE
+        (type='table' AND name=?) OR (type='trigger' AND name IN (?,?,?))`).get(TABLE, INSERT, UPDATE, DELETE).n === 4;
+    db.exec('SAVEPOINT kairo_jspace_summary_inputs_install');
+    try {
+        db.exec(`CREATE TABLE IF NOT EXISTS ${TABLE}(
+            character_id INTEGER NOT NULL,id TEXT NOT NULL,body TEXT,
+            PRIMARY KEY(character_id,id)) WITHOUT ROWID;
+        CREATE TRIGGER IF NOT EXISTS ${INSERT} AFTER INSERT ON universe_records WHEN NEW.kind='jspace_map' BEGIN
+            DELETE FROM ${TABLE} WHERE character_id=NEW.character_id AND id=NEW.id;
+            INSERT INTO ${TABLE}(character_id,id,body) VALUES(NEW.character_id,NEW.id,${compactBody('NEW.body')});
+        END;
+        CREATE TRIGGER IF NOT EXISTS ${UPDATE} AFTER UPDATE OF character_id,kind,id,body ON universe_records
+        WHEN OLD.kind='jspace_map' OR NEW.kind='jspace_map' BEGIN
+            DELETE FROM ${TABLE} WHERE (OLD.kind='jspace_map' AND character_id=OLD.character_id AND id=OLD.id)
+                OR (NEW.kind='jspace_map' AND character_id=NEW.character_id AND id=NEW.id);
+            INSERT INTO ${TABLE}(character_id,id,body) SELECT NEW.character_id,NEW.id,${compactBody('NEW.body')}
+                WHERE NEW.kind='jspace_map';
+        END;
+        CREATE TRIGGER IF NOT EXISTS ${DELETE} AFTER DELETE ON universe_records WHEN OLD.kind='jspace_map' BEGIN
+            DELETE FROM ${TABLE} WHERE character_id=OLD.character_id AND id=OLD.id;
+        END;`);
+        if (!installed) {
+            db.exec(`DELETE FROM ${TABLE};
+                INSERT INTO ${TABLE}(character_id,id,body)
+                SELECT character_id,id,${compactBody('records.body')}
+                FROM universe_records AS records WHERE kind='jspace_map';`);
+        }
+        db.exec('RELEASE kairo_jspace_summary_inputs_install');
+    } catch (error) {
+        db.exec('ROLLBACK TO kairo_jspace_summary_inputs_install');
+        db.exec('RELEASE kairo_jspace_summary_inputs_install');
+        throw error;
+    }
+    const rows = db.prepare(`SELECT records.id AS record_id,inputs.body IS NOT NULL AS compact,
+        COALESCE(inputs.body,records.body) AS body
+        FROM universe_records AS records LEFT JOIN ${TABLE} AS inputs
+        ON inputs.character_id=records.character_id AND inputs.id=records.id
+        WHERE records.character_id=? AND records.kind='jspace_map'
+        ORDER BY records.updated_at DESC,records.id`);
+    const compact = db.prepare(`SELECT 1 FROM ${TABLE} WHERE character_id=? AND id=? AND body IS NOT NULL`);
+    return { all: id => rows.all(id), hasCompact: (id, key) => !!compact.get(id, key) };
+}

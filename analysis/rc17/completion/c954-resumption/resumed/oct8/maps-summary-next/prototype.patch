+test('parent rollback, savepoint rollback, ignored conflict and failed statement preserve derivative visibility', t => {
+    const f = fixture(t), initial = map(); f.put(initial); const original = f.side(initial.id).body;
+    f.db.exec('BEGIN IMMEDIATE'); f.put({ ...initial, name: 'Outer uncommitted' });
+    assert.equal(parsed(f.inputs)[0].name, 'Outer uncommitted');
+    f.db.exec('SAVEPOINT caller'); f.put({ ...initial, name: 'Inner uncommitted' });
+    f.db.exec('ROLLBACK TO caller; RELEASE caller');
+    assert.equal(parsed(f.inputs)[0].name, 'Outer uncommitted');
+    f.db.exec('ROLLBACK'); assert.equal(f.side(initial.id).body, original); assert.deepEqual(JSON.parse(f.raw(initial.id)), initial);
+    f.db.prepare('INSERT OR IGNORE INTO universe_records VALUES(?,?,?,?,?)').run(42, 'jspace_map', initial.id, JSON.stringify({ ...initial, name: 'Ignored' }), AT);
+    assert.equal(f.side(initial.id).body, original);
+    assert.throws(() => f.db.prepare('INSERT INTO universe_records VALUES(?,?,?,?,?)').run(42, 'jspace_map', initial.id, JSON.stringify(initial), AT));
+    assert.equal(f.side(initial.id).body, original);
+});

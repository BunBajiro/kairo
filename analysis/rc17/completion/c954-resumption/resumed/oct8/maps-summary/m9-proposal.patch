+test('summary inputs omit wide retained text without changing storage or losing direct replacements', async t => {
+    const f = await fixture(t), created = f.create('Wide map');
+    f.api.summaries(42); // Establish the independently required source descriptor before counting no-op writes.
+    const get = f.store.db.prepare("SELECT body FROM universe_records WHERE character_id=42 AND kind='jspace_map' AND id=?");
+    const put = f.store.db.prepare("UPDATE universe_records SET body=? WHERE character_id=42 AND kind='jspace_map' AND id=?");
+    const map = JSON.parse(get.get(created.id).body), edge = map.connections[0];
+    map.comments[0].body = 'Retained comment '.repeat(200);
+    map.passages = [{ id: 'valid-passage', connection_id: edge.id, notes: 'Retained passage '.repeat(100), occurred_at: new Date(AT).toISOString() }];
+    map.observations = [{ id: 'observation', system_id: W, body: 'Retained observation '.repeat(200) }];
+    map.archived_nodes = [{ system_id: 31999999, description: 'Retained archive '.repeat(200) }];
+    map.nodes[0].description = 'Retained node '.repeat(200);
+    const body = JSON.stringify(map); put.run(body, map.id);
+    const before = f.store.db.prepare('SELECT total_changes() AS n').get().n;
+    const read = f.read(() => f.api.summaries(42));
+    const row = read.value.maps.find(row => row.id === map.id);
+    assert.equal(row.name, 'Wide map'); assert.equal(row.node_count, 3); assert.equal(row.connection_count, 2);
+    assert.equal(get.get(map.id).body, body);
+    assert.equal(f.store.db.prepare('SELECT total_changes() AS n').get().n, before);
+    const transferred = read.queries.flatMap(query => query.rows).filter(row => typeof row.body === 'string').map(row => row.body);
+    assert.ok(transferred.every(body => !body.includes('Retained ')), 'Summary must not transfer retained wide payload text from SQLite');
+    assert.ok(transferred.reduce((sum, body) => sum + body.length, 0) < body.length / 2);
+    map.name = 'Immediate replacement'; map.revision += 5; map.scope = { systems: [W] }; put.run(JSON.stringify(map), map.id);
+    const next = f.api.summaries(42).maps.find(row => row.id === map.id);
+    assert.equal(next.name, map.name); assert.equal(next.revision, map.revision); assert.deepEqual(next.scope, map.scope);
+    assert.equal(f.api.map(42, map.id).comments[0].body, map.comments[0].body);
+});

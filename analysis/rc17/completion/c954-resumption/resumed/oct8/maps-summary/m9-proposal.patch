+test('summary-first legacy cleanup loads the complete document before persisting', async t => {
+    const f = await fixture(t), created = f.create('Legacy map');
+    const get = () => JSON.parse(f.store.db.prepare("SELECT body FROM universe_records WHERE character_id=42 AND kind='jspace_map' AND id=?").get(created.id).body);
+    const map = get(); map.connections[0].locked = false; map.archived_connections = []; delete map.activity;
+    map.nodes[0].description = 'Keep node details'; map.archived_nodes = [{ system_id: 31999999, description: 'Keep archive' }];
+    map.passages = [{ id: 'valid', connection_id: map.connections[0].id, notes: 'Keep valid passage' }, { id: 'dangling', connection_id: 'gone', notes: 'Remove dangling passage' }];
+    map.comments.push({ id: 'dangling', connection_id: 'gone', body: 'Remove dangling comment' });
+    f.store.db.prepare("UPDATE universe_records SET body=? WHERE character_id=42 AND kind='jspace_map' AND id=?").run(JSON.stringify(map), map.id);
+    f.api.summaries(42);
+    const saved = get();
+    assert.equal(saved.nodes[0].description, 'Keep node details'); assert.deepEqual(saved.archived_nodes, map.archived_nodes);
+    assert.deepEqual(saved.passages, [map.passages[0]]); assert.deepEqual(saved.comments, map.comments.slice(0, 2));
+    assert.ok(!Object.hasOwn(saved.connections[0], 'locked')); assert.ok(!Object.hasOwn(saved, 'archived_connections')); assert.deepEqual(saved.activity, []);
+});
